DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
EXPO_PUBLIC_PROXY_URL=

# Django settings (backend/config/settings.py)
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Never set to True in production
DJANGO_DEBUG=False
# Comma-separated list of hostnames Django will serve, e.g. api.cotici.com
DJANGO_ALLOWED_HOSTS=
# Comma-separated list of frontend origins allowed to call the API, e.g. https://app.cotici.com
DJANGO_CORS_ALLOWED_ORIGINS=
# Mobile Money (Orange/MTN/Wave/Moov) sandbox mode.
# Il n'existe PAS aujourd'hui de véritable intégration Mobile Money : tant que
# ce flag est True, le endpoint wallet/deposit/ crédite le wallet directement
# (mode démo/dev) et renvoie "sandbox": true dans sa réponse.
# METTRE À False avant tout déploiement "production" tant qu'une vraie
# intégration Mobile Money n'a pas été implémentée : le endpoint refusera
# alors les dépôts (503) plutôt que de créditer de l'argent fictif.
MOBILE_MONEY_SANDBOX=True

# CinetPay (agrégateur Mobile Money) — utilisé uniquement quand
# MOBILE_MONEY_SANDBOX=False. Identifiants marchand CinetPay (Checkout API v2).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_CURRENCY=XOF
# URL publique du webhook backend (POST, sans JWT) : apps/wallet/urls.py -> wallet-deposit-notify
CINETPAY_NOTIFY_URL=
# URL/deeplink de retour affichée au client après paiement (page de statut app mobile)
CINETPAY_RETURN_URL=

# CinetPay Transfer/PayOut API v1 — utilisée uniquement pour le RETRAIT
# (apps/wallet/views.py::withdrawal, quand MOBILE_MONEY_SANDBOX=False).
# API distincte de la Checkout API ci-dessus : mot de passe de transfert
# DISTINCT de CINETPAY_API_KEY, fourni séparément par CinetPay.
CINETPAY_TRANSFER_PASSWORD=
# URL publique du webhook backend (POST, sans JWT) : apps/wallet/urls.py -> wallet-withdrawal-notify
CINETPAY_TRANSFER_NOTIFY_URL=
# Indicatif pays par défaut (sans "+") utilisé pour découper numero_telephone
# en (prefix, numéro local) attendu par l'API Transfer CinetPay.
CINETPAY_DEFAULT_PHONE_PREFIX=225

# Envoi de SMS pour les OTP (apps/authn/sms.py).
# "console" (dev, code OTP loggé en clair) ou "cinetpay" (envoi réel).
# Toute autre valeur fait échouer l'envoi (pas de fallback silencieux).
SMS_PROVIDER=console
# Compte SMS CinetPay (API Notitia) — SÉPARÉ du compte marchand Mobile Money
# ci-dessus (autre clé API). S'obtient auprès de hello@cinetpay.com.
CINETPAY_SMS_API_KEY=
# Sender ID alphanumérique CinetPay (ex "COTICI"), fourni avec la clé API SMS.
CINETPAY_SMS_SENDER=

# Back-office administrateur (apps.administration) — cf. backend/config/settings_admin.py.
# Origine (scheme+host[:port]) du front back-office, nécessaire aux contrôles CSRF/Referer.
ADMIN_ORIGIN=
# Allowlist IP (CIDR séparés par des virgules) autorisée à atteindre /api/admin/.
# Vide -> autorisé uniquement si DJANGO_DEBUG=True (refusé sinon, fail-closed).
ADMIN_IP_ALLOWLIST=
# Nombre de proxies de confiance en amont (load balancer...) : détermine la position,
# en partant de la fin, de l'IP cliente réelle dans l'en-tête X-Forwarded-For.
# 0 = X-Forwarded-For est ignoré (anti-spoofing) et seul REMOTE_ADDR fait foi.
ADMIN_TRUSTED_PROXY_COUNT=0
# Idle-timeout applicatif (secondes) de la session administrateur.
ADMIN_SESSION_IDLE_SECONDS=900
# Durée de vie du cookie de session administrateur (secondes).
ADMIN_SESSION_COOKIE_AGE_SECONDS=28800
# TTL (secondes) de l'état de pré-authentification (entre mot de passe et TOTP).
ADMIN_PREAUTH_TTL_SECONDS=300
# Nom affiché par les applications TOTP (Google Authenticator, Authy...).
TOTP_ISSUER=COTICI Admin

# Second facteur obligatoire pour le back-office administrateur.
# True en production, sans exception.
ADMIN_TOTP_REQUIRED=True
